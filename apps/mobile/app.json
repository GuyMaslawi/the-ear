{
  "expo": {
    "name": "האוזן",
    "slug": "the-ear-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1426"
    },
    "ios": {
      "bundleIdentifier": "com.theear.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "האוזן משתמשת במיקום שלך כדי להראות שאלות ועדכונים שנמצאים קרוב אליך, וכדי לוודא שתשובות מגיעות מאנשים שבאמת נמצאים באזור. המיקום המדויק שלך לא מוצג למשתמשים אחרים."
      }
    },
    "android": {
      "package": "com.theear.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1426"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "האוזן משתמשת במיקום שלך כדי להראות שאלות ועדכונים שנמצאים קרוב אליך, וכדי לוודא שתשובות מגיעות מאנשים שבאמת נמצאים באזור. המיקום המדויק שלך לא מוצג למשתמשים אחרים."
        }
      ]
    ],
    "extra": {}
  }
}
