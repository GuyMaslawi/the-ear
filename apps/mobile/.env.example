# Optional overrides (otherwise app.config.js picks your LAN IP for real devices;
# simulators use localhost / 10.0.2.2 automatically — see src/lib/config.ts).
#
# Replace YOUR_LOCAL_IP with the Mac’s Wi‑Fi address (same as System Settings → Network),
# e.g. http://192.168.1.42:3000
#
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000
EXPO_PUBLIC_SOCKET_URL=http://YOUR_LOCAL_IP:3000
