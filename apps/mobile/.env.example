# Local development overrides (Expo inlines EXPO_PUBLIC_* at bundle time).
#
# Simulators (iOS/Android) auto-resolve to localhost / 10.0.2.2 — usually no env needed.
# For a PHYSICAL device on the same Wi‑Fi, either:
#   (a) leave these unset — app.config.js auto-detects your Mac's LAN IP, or
#   (b) set them explicitly below (replace YOUR_LOCAL_IP with the Mac's Wi‑Fi address,
#       e.g. http://192.168.1.42:3000)
#
# For TestFlight / production builds, DO NOT use this file —
# set EXPO_PUBLIC_API_URL inside eas.json (build.production.env) instead.
# It MUST be HTTPS (iOS ATS blocks plain http in shippable builds).
#
# EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000
# EXPO_PUBLIC_SOCKET_URL=http://YOUR_LOCAL_IP:3000
#
# Android Google Maps API key — required for MapScreen (PROVIDER_GOOGLE) on Android.
# Without it, Android map tiles will fail to render. iOS uses Apple Maps and does NOT need this.
# For local dev: copy this file to `.env` and fill in the value (the .env file is gitignored).
# For EAS builds: store as an EAS secret
# (e.g. `eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY --value <KEY>`).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Backend API base URL. Leave blank for local dev to auto-detect LAN IP (see top of file).
EXPO_PUBLIC_API_URL=
