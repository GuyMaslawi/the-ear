{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_SOCKET_URL": "$EXPO_PUBLIC_SOCKET_URL",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_SOCKET_URL": "$EXPO_PUBLIC_SOCKET_URL",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
